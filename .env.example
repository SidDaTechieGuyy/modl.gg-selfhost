# The public address, including http:// or https://, with no path or trailing slash.
BASE_URL=http://localhost:8181
# Internal Compose database address. No MongoDB port is published to the host.
MONGODB_URI=mongodb://mongodb:27017/modl
# The backend generates its signing key automatically and persists it in uploads.
# Keep the entire uploads volume, including hidden files, with your backups.
# Optional: only needed when enabling AI moderation in settings.
GEMINI_API_KEY=
