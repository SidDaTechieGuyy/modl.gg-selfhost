# The public address, including http:// or https://, with no path or trailing slash.
BASE_URL=http://localhost:8080
# Internal Compose database address. No MongoDB port is published to the host.
MONGODB_URI=mongodb://mongodb:27017/modl
# Replace with a randomly generated secret of at least 32 characters.
# Used to sign persistent file and ticket capabilities. Keep it with your backups.
SESSION_SECRET=replace-with-at-least-32-random-characters
# One origin, comma-separated origins, * or dynamic. Never include paths.
# * and dynamic both reflect any valid incoming HTTP(S) origin with credentials.
CORS_ALLOWED_ORIGINS=http://localhost:8080
# Optional: only needed when enabling AI moderation in settings.
GEMINI_API_KEY=
