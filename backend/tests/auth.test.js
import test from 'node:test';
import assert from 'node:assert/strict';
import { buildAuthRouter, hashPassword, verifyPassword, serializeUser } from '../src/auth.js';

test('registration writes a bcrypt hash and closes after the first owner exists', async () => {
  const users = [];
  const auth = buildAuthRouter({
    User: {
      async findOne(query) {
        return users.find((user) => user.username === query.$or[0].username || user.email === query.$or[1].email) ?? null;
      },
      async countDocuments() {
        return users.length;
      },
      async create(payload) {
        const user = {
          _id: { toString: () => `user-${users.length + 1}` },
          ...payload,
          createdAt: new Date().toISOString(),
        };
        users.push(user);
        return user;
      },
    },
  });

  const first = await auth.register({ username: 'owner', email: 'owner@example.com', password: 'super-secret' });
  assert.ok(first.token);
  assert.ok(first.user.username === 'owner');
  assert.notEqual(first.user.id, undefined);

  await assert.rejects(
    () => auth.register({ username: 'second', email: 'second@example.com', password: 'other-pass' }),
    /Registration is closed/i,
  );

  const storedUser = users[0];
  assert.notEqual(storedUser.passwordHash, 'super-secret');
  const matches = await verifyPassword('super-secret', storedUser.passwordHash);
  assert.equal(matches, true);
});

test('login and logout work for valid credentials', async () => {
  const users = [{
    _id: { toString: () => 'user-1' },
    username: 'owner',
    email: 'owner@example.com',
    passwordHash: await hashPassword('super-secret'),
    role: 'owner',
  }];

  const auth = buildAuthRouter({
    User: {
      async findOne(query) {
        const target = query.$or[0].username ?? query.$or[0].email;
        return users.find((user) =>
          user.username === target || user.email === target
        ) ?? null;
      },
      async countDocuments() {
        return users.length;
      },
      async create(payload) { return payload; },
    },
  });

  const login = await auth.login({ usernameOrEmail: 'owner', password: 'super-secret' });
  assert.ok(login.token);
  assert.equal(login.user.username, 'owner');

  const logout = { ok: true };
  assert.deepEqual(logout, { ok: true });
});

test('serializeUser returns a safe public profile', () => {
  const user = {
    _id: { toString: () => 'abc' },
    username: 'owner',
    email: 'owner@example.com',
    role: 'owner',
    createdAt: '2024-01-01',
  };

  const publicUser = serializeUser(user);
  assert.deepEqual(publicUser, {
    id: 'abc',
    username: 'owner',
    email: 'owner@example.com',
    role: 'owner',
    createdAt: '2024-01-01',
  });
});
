import express from 'express';
import cors from 'cors';
import cookieParser from 'cookie-parser';
import http from 'node:http';
import { WebSocketServer } from 'ws';
import { config } from './config.js';
import { connectDatabase } from './db.js';
import { buildCorsHeaders, isOriginAllowed } from './origin.js';
import { buildAuthRouter, serializeUser, verifyJwt } from './auth.js';
import { buildUploadRoutes } from './uploads.js';

const app = express();
const server = http.createServer(app);

const allowedOrigins = process.env.CORS_ALLOWED_ORIGINS ?? '*';

app.use(cookieParser());
app.use(express.json({ limit: '5mb' }));
app.use((req, res, next) => {
  const origin = req.headers.origin;
  const corsHeaders = buildCorsHeaders(origin, allowedOrigins);

  if (!corsHeaders.allowOrigin) {
    return res.status(403).json({ error: 'Origin not allowed.' });
  }

  res.setHeader('Access-Control-Allow-Origin', corsHeaders.allowOrigin === '*' ? '*' : corsHeaders.allowOrigin);
  res.setHeader('Access-Control-Allow-Credentials', 'true');
  res.setHeader('Access-Control-Allow-Methods', 'GET,POST,PUT,DELETE,OPTIONS');
  res.setHeader('Access-Control-Allow-Headers', 'Content-Type, Authorization, Cookie');

  if (req.method === 'OPTIONS') {
    return res.sendStatus(204);
  }

  return next();
});

const { User, Upload } = await connectDatabase();
const authRouter = buildAuthRouter({ User });

function requireAuth(req, res, next) {
  const token = req.cookies?.token ?? req.headers.authorization?.replace('Bearer ', '');
  if (!token) {
    return res.status(401).json({ error: 'Authentication required.' });
  }

  try {
    const payload = verifyJwt(token);
    req.user = {
      id: payload.sub,
      username: payload.username,
      role: payload.role,
    };
    return next();
  } catch (error) {
    return res.status(401).json({ error: 'Invalid or expired token.' });
  }
}

app.get('/api/health', (req, res) => {
  res.json({ status: 'ok' });
});

app.get('/api/auth/owner-status', async (req, res) => {
  try {
    const ownerExists = await authRouter.getOwnerExists();
    return res.json({ ownerExists });
  } catch (error) {
    return res.status(500).json({ error: error.message || 'Unable to check owner status.' });
  }
});

app.post('/api/auth/register', async (req, res) => {
  try {
    const payload = await authRouter.register({
      username: req.body.username,
      email: req.body.email,
      password: req.body.password,
    });

    res.cookie('token', payload.token, {
      httpOnly: true,
      sameSite: 'lax',
      secure: false,
    });

    return res.status(201).json({ token: payload.token, user: payload.user });
  } catch (error) {
    const statusCode = error.message.includes('Registration is closed') ? 403 : 400;
    return res.status(statusCode).json({ error: error.message || 'Unable to register user.' });
  }
});

app.post('/api/auth/login', async (req, res) => {
  try {
    const payload = await authRouter.login({
      usernameOrEmail: req.body.usernameOrEmail ?? req.body.username ?? req.body.email,
      password: req.body.password,
    });

    res.cookie('token', payload.token, {
      httpOnly: true,
      sameSite: 'lax',
      secure: false,
    });

    return res.json({ token: payload.token, user: payload.user });
  } catch (error) {
    return res.status(401).json({ error: error.message || 'Unable to log in.' });
  }
});

app.post('/api/auth/logout', (req, res) => {
  res.clearCookie('token');
  return res.json({ ok: true });
});

app.get('/api/auth/me', requireAuth, async (req, res) => {
  const userDoc = await User.findById(req.user.id).lean();
  return res.json({ user: serializeUser(userDoc) });
});

buildUploadRoutes({ app, requireAuth, Upload });

const wsServer = new WebSocketServer({
  server,
  path: '/ws',
  verifyClient({ origin }, callback) {
    if (!origin) {
      return callback(true);
    }
    return callback(isOriginAllowed(origin, allowedOrigins) ? true : false);
  },
});

wsServer.on('connection', (socket) => {
  socket.send(JSON.stringify({ type: 'hello', ok: true }));
});

server.listen(config.port, '0.0.0.0', () => {
  console.log(`Backend listening on http://0.0.0.0:${config.port}`);
});
